<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      android:allowBackup="false": keyboard state (learned words, preferences) must never
      be sent to Google cloud backup. A restored dictionary from another device or user is
      a privacy defect — the only safe policy is no cloud backup at all.
      android:dataExtractionRules: Android 12+ full-backup exclusion (redundant with
      allowBackup=false but belt-and-suspenders since AGP may still merge library rules).
      android:fullBackupContent: pre-12 equivalent.
    -->
    <!--
      android:supportsRtl="true": required by 05-device-framework-compatibility.md §5.1.
      Use start/end (not left/right) everywhere in layouts; RTL mirroring has been
      available since API 17 so every supported device handles it natively.
    -->

    <!--
      RECORD_AUDIO — required for the opt-in voice input feature (T5.2).
      This is a dangerous runtime permission; the user is prompted at runtime only when
      the voice key is used and the feature is enabled in Settings. The keyboard operates
      fully without it (voice input degrades gracefully when permission is absent).
      No audio is ever recorded without an explicit user gesture (voice key press).
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.Tally"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:supportsRtl="true">
        <activity
            android:name="dev.tally.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="dev.tally.OnboardingActivity"
            android:exported="false"
            android:label="@string/app_name" />
        <activity
            android:name="dev.tally.SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:parentActivityName="dev.tally.MainActivity" />
        <activity
            android:name="dev.tally.AboutActivity"
            android:exported="false"
            android:label="@string/about"
            android:parentActivityName="dev.tally.MainActivity" />
    </application>
</manifest>
