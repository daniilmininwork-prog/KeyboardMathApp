<?xml version="1.0" encoding="utf-8"?>
<!-- Background for the key-preview bubble: white rounded rectangle with a soft shadow.
     The shape is kept simple so it works on all API levels we support (minSdk 26). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/key_preview_bg" />
    <corners android:radius="@dimen/key_preview_corner_radius" />
</shape>
