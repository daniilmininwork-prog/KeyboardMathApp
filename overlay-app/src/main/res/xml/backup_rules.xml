<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 11 and below cloud-backup exclusions (pre-12 fullBackupContent equivalent).

  Mirrors data_extraction_rules.xml for older API levels. The overlay app's only persisted
  state is the shared TallyPreferences file; it is excluded so settings never travel between
  users or devices via cloud backup.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
