<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Application label (shown in Settings > Apps). -->
    <string name="app_name">Tally Calculate</string>

    <!--
      Label for the text-selection toolbar item. This is the exact text the user taps
      after selecting an expression in any app. Kept short so it fits the floating toolbar.
    -->
    <string name="process_text_label">Tally: Calculate</string>

    <!--
      Shown on the result card when the selection cannot be read or is empty. Friendly, non-technical.
    -->
    <string name="error_no_text">No text to calculate.</string>

    <!--
      Shown on the result card when the selection is not a math expression Tally can evaluate.
      The original selection is left untouched.
    -->
    <string name="error_not_expression">Not a math expression Tally can calculate.</string>

    <!--
      Read-only result line on the card (e.g. when the source field is not editable, or the host —
      like Chrome — only invokes process-text read-only). %1$s is the formatted result.
    -->
    <string name="result_readonly">= %1$s</string>

    <!-- Copy-to-clipboard action on the result card. -->
    <string name="copy_result">Copy</string>

    <!-- In-place copy confirmation on pre-13 Android (13+ shows the system clipboard overlay instead). -->
    <string name="copied">Copied</string>
</resources>
